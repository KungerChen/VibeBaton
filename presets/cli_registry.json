{
  "schema_version": 1,
  "tags": [
    {
      "id": "official",
      "label_en": "Official",
      "label_zh": "官方",
      "summary_en": "Published and maintained by the model vendor.",
      "summary_zh": "由模型厂商官方发布并维护。"
    },
    {
      "id": "community",
      "label_en": "Community",
      "label_zh": "社区",
      "summary_en": "Open-source tool maintained by the community.",
      "summary_zh": "由开源社区维护的工具。"
    }
  ],
  "drivers": [
    {
      "id": "claude",
      "name": "Claude Code",
      "tier": "official",
      "binary": "claude",
      "summary_en": "Anthropic's agentic coding CLI; edits multiple files and runs commands in your repository.",
      "summary_zh": "Anthropic 官方的智能编程命令行工具，可在仓库内跨文件修改代码并执行命令。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@anthropic-ai/claude-code"],
      "login_cmd": ["claude", "auth", "login"],
      "auth_check_cmd": ["claude", "auth", "status"],
      "official_url": "https://docs.claude.com/en/docs/claude-code/overview",
      "command_template": ["claude", "-p", "--model", "{model_name}", "--effort", "{effort}", "--dangerously-skip-permissions", "--output-format", "json"],
      "version_cmd": ["claude", "--version"],
      "provider_ids": ["claude_sub"],
      "env_keys": ["ANTHROPIC_API_KEY"]
    },
    {
      "id": "codex",
      "name": "OpenAI Codex",
      "tier": "official",
      "binary": "codex",
      "summary_en": "OpenAI's terminal coding agent; reads the repository, edits files and runs commands for multi-step tasks.",
      "summary_zh": "OpenAI 官方的终端编程智能体，可读取仓库、修改文件并执行命令以完成多步任务。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@openai/codex"],
      "login_cmd": ["codex", "login"],
      "auth_check_cmd": ["codex", "login", "status"],
      "official_url": "https://developers.openai.com/codex/cli/",
      "command_template": ["codex", "exec", "--json", "--model", "{model_name}", "-c", "model_reasoning_effort=\"{effort}\"", "-s", "workspace-write", "-c", "approval_policy=\"never\"", "-o", "{output_file}", "-"],
      "version_cmd": ["codex", "--version"],
      "provider_ids": ["codex_sub"],
      "env_keys": ["OPENAI_API_KEY"]
    },
    {
      "id": "dsh",
      "name": "DSH",
      "tier": "official",
      "binary": "dsh",
      "summary_en": "DSH (DeepSeek Harness) runs fast DeepSeek coding sessions in the background without an interactive window.",
      "summary_zh": "DSH（DeepSeek Harness）在后台高速执行 DeepSeek 编程任务，无需打开交互窗口。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@deepseek-ai/dsh"],
      "login_cmd": ["dsh"],
      "auth_check_cmd": null,
      "official_url": "https://www.npmjs.com/package/@deepseek-ai/dsh",
      "command_template": ["dsh", "--profile", "headless", "--patch", "{package_root}/presets/dsh-headless-opencode-go.patch.yml", "--json", "--permission-mode", "workspace-write", "--approval-policy", "never", "-"],
      "version_cmd": ["dsh", "--version"],
      "provider_ids": ["dsh_opencode"],
      "env_keys": ["OPENCODE_API_KEY"]
    },
    {
      "id": "gemini",
      "name": "Gemini CLI",
      "tier": "official",
      "binary": "gemini",
      "summary_en": "Google's terminal coding agent; works across files and runs commands with Gemini models.",
      "summary_zh": "Google 官方的终端编程智能体，使用 Gemini 模型跨文件工作并执行命令。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@google/gemini-cli"],
      "login_cmd": ["gemini"],
      "auth_check_cmd": null,
      "official_url": "https://github.com/google-gemini/gemini-cli",
      "command_template": ["gemini", "--model", "{model_name}", "--output-format", "json", "--yolo", "-p", "{prompt}"],
      "version_cmd": ["gemini", "--version"],
      "provider_ids": ["gemini_http"],
      "env_keys": ["GEMINI_API_KEY"]
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "tier": "community",
      "binary": "opencode",
      "summary_en": "Open-source coding agent for the terminal with a rich TUI and support for many model providers.",
      "summary_zh": "开源终端编程智能体，提供完整的终端界面并支持多种模型提供商。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "opencode-ai"],
      "login_cmd": ["opencode", "auth", "login"],
      "auth_check_cmd": ["opencode", "auth", "list"],
      "official_url": "https://opencode.ai/docs/",
      "command_template": ["opencode", "run", "--model", "{model_name}", "--format", "json", "{prompt}"],
      "version_cmd": ["opencode", "--version"],
      "provider_ids": ["dsh_opencode"],
      "env_keys": ["OPENCODE_API_KEY"]
    },
    {
      "id": "aider",
      "name": "Aider",
      "tier": "community",
      "binary": "aider",
      "summary_en": "Open-source pair-programming CLI that edits files in your local Git repository through chat.",
      "summary_zh": "开源结对编程命令行工具，通过对话直接修改本地 Git 仓库中的文件。",
      "prereq": ["python"],
      "install_cmd": ["pipx", "install", "aider-chat"],
      "login_cmd": ["aider"],
      "auth_check_cmd": null,
      "official_url": "https://aider.chat/docs/",
      "command_template": ["aider", "--model", "{model_name}", "--message-file", "{prompt_file}", "--yes", "--no-pretty"],
      "version_cmd": ["aider", "--version"],
      "provider_ids": ["openai_http"],
      "env_keys": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"]
    },
    {
      "id": "qwen",
      "name": "Qwen Code",
      "tier": "official",
      "binary": "qwen",
      "summary_en": "Qwen's open-source coding CLI, built on Gemini CLI and tuned for Qwen models.",
      "summary_zh": "Qwen 开源的编程命令行工具，基于 Gemini CLI 构建并针对 Qwen 模型优化。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@qwen-code/qwen-code"],
      "login_cmd": ["qwen"],
      "auth_check_cmd": null,
      "official_url": "https://github.com/QwenLM/qwen-code",
      "command_template": ["qwen", "--model", "{model_name}", "--output-format", "json", "--yolo", "-p", "{prompt}"],
      "version_cmd": ["qwen", "--version"],
      "provider_ids": ["openai_http"],
      "env_keys": ["DASHSCOPE_API_KEY"]
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot CLI",
      "tier": "official",
      "binary": "copilot",
      "summary_en": "GitHub's terminal coding agent; installs with npm and signs in with a GitHub Copilot account.",
      "summary_zh": "GitHub 官方的终端编程智能体，通过 npm 安装并使用 GitHub Copilot 账号登录。",
      "prereq": ["node"],
      "install_cmd": ["npm", "install", "-g", "@github/copilot"],
      "login_cmd": ["copilot", "login"],
      "auth_check_cmd": null,
      "official_url": "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-command-reference",
      "command_template": ["copilot", "--model", "{model_name}", "--allow-all-tools", "-p", "{prompt}"],
      "version_cmd": ["copilot", "--version"],
      "provider_ids": ["openai_http"],
      "env_keys": []
    }
  ]
}
